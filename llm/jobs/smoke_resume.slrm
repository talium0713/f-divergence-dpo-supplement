#!/bin/bash
# Smoke test for --resume-adapter / --resume-step (added 2026-09-19).
#
# The six 4B LoRA runs and both finished Gemma runs all died on the 23 h wall, 300-700 steps short of
# 1910, leaving only a periodic adapter. Taking those adapters as final policies would compare Amari
# against canonical at DIFFERENT step counts (4B canon s1 at 1600 vs amari s1 at 1000, Gemma amari s0
# at 1200 vs canon s0 at 1600), so the arms have to be finished, not truncated.
#
# WHAT THIS CHECKS. The adapter is weights only — no AdamW moments, no scheduler or RNG state — so the
# question is whether the weights actually land. The tell is the first resumed step's loss: a correctly
# loaded step-1600 adapter continues near its dying loss (~0.45-0.55); a silently empty load restarts at
# -log sigmoid(0) = ln 2 = 0.693. --log-every 1 puts that number in the log within one step.
# Also printed: the replayed LR, which at step 1600 of a linear decay with 95 warmup steps must be
#   5e-6 * (1910-1600)/(1910-95) = 8.54e-7.
#
# Reads the RESCUED copy, never the live adapter, and writes to a throwaway --out.
#
#SBATCH --account=ACCOUNT
#SBATCH --job-name=smokeresume
#SBATCH --gres=gpu:l40s:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=00:45:00
#SBATCH --output=logs/%x-%j.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"
RESCUED="/scratch/$USER/bregman-lab/llm/results/bench/_rescued_20260919"
OUT="/scratch/$USER/bregman-lab/llm/results/bench/_smoke_resume"

echo "=== resume smoke: 4B LoRA canon seed 1, resuming at step 1600 on $(hostname) | $(date) ==="; nvidia-smi
python stage_b_train.py \
  --ref Qwen/Qwen3-4B-Base --policy Qwen/Qwen3-4B-Base --init-noise 0.01 \
  --lora-r 128 --lora-alpha 128 --lora-dropout 0.05 --save-adapter-every 0 \
  --resume-adapter "$RESCUED/stageB_lora4b_kl_canon_bdpo_token_s1_adapter" --resume-step 1600 \
  --data data/uf_pairs_train_full.jsonl --eval-data data/uf_pairs_test.jsonl \
  --div kl --norm canon --inner sample --step-mode token \
  --beta 0.1 --lr 5e-6 --lr-schedule linear --warmup-ratio 0.05 --weight-decay 0.01 --adam-beta2 0.999 \
  --epochs 2 --grad-accum 64 --grad-clip 1.0 --max-len 1024 --clamp 15 \
  --eval-n 256 --log-every 1 --eval-every 100000 --seed 1 \
  --out "$OUT"
echo "=== done | $(date) ==="
