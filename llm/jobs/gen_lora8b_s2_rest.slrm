#!/bin/bash
# The last three Arena-Hard generations of the 8B LoRA seed-2 block: adiv (both arms, trained on
# cluster) and chi2 canonical (its Amari partner was trained and generated on the rented box).
# With these, 8B LoRA is six divergences x three seeds with nothing left ungenerated.
#
#   0 adiv amari   1 adiv canon   2 chi2 canon
# Flags are byte-identical to jobs/gen_lora8b.slrm, which produced every other 8B answer file.
#
#SBATCH --account=ACCOUNT
#SBATCH --job-name=g8bs2
#SBATCH --gres=gpu:l40s:1
#SBATCH --array=0-2
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=4:00:00
#SBATCH --output=logs/%x-%A_%a.out

set -euo pipefail
REPO="$SLURM_SUBMIT_DIR/.."
export HF_HOME="/scratch/$USER/hf_cache"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

module load StdEnv/2023 python/3.11 cuda/12.2
source "$REPO/venv_gpu/bin/activate"
cd "$REPO/llm"

SPECS=("adiv|amari" "adiv|canon" "chi2|canon")
IFS="|" read -r DIV NORM <<< "${SPECS[$SLURM_ARRAY_TASK_ID]}"
POL="/scratch/$USER/bregman-lab/llm/results/bench/stageB_lora8b_${DIV}_${NORM}_bdpo_token_s2_policy"
TAG="lora8b_${DIV}_${NORM}_bdpo_s2"
OUT="results/bench/arena_v01/${TAG}.jsonl"
[ -d "$POL" ] || { echo "policy $POL missing"; exit 1; }
[ -f "$OUT" ] && [ "$(wc -l < "$OUT")" -eq 500 ] && { echo "[skip] $TAG"; exit 0; }

echo "=== gen Arena-Hard v0.1 [$TAG] from $POL on $(hostname) | $(date) ==="; nvidia-smi
python gen_bench.py --model "$POL" --generator "$TAG" --prompts data/arena_hard_v01.jsonl \
  --format arenav2 --think default --system "You are a helpful assistant." \
  --rep-penalty 1.05 --max-new 1024 --temperature 0.0 --out "$OUT"
echo "=== done $TAG | $(date) ==="
